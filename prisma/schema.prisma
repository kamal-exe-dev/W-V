generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  contactName String
  email       String
  phone       String
  website     String?
  industry    String?
  status      String   @default("Active") // Active | Inactive
  rating      Int      @default(5)
  createdAt   DateTime @default(now())

  projects      Project[]
  invoices      Invoice[]
  transactions  Transaction[]
  proposals     Proposal[]
  conversation  Conversation?
  supportTickets SupportTicket[]
  deliverables  Deliverable[]
  user          User?
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  email      String
  phone      String
  department String   // Engineering | Design | Marketing | Management
  status     String   @default("Active") // Active | On Leave
  rating     Float    @default(4.5)
  skills     Json     // string[]
  createdAt  DateTime @default(now())

  assignments ProjectAssignment[]
  timeEntries TimeEntry[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  clientId  String
  service   String
  status    String   @default("Planning") // Planning | In Progress | Review | Completed
  progress  Int      @default(0)
  priority  String   @default("Medium") // Low | Medium | High
  value     Int      // whole rupees
  dueDate   DateTime
  createdAt DateTime @default(now())

  client       Client               @relation(fields: [clientId], references: [id])
  assignments  ProjectAssignment[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  deliverables Deliverable[]
}

model ProjectAssignment {
  id           String @id @default(cuid())
  projectId    String
  teamMemberId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamMemberId])
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique
  clientId  String
  projectId String?
  amount    Int
  status    String   @default("Draft") // Draft | Sent | Paid | Overdue
  issueDate DateTime @default(now())
  dueDate   DateTime
  createdAt DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Int
  type        String   // income | expense
  category    String   // Client Payment | Salaries | Software & Tools | Marketing | Infrastructure | Office & Admin | Misc
  clientId    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id])
}

model TimeEntry {
  id           String   @id @default(cuid())
  projectId    String
  teamMemberId String
  task         String
  date         DateTime @default(now())
  hours        Float
  billable     Boolean  @default(true)
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id])
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  clientId  String   @unique
  updatedAt DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  sender         String   // me | them
  text           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Proposal {
  id        String   @id @default(cuid())
  title     String
  clientId  String
  value     Int
  status    String   @default("Draft") // Draft | Sent | Accepted | Rejected
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  channel   String   // Email | Social | Search | Ads
  status    String   @default("Active") // Active | Paused | Completed
  spend     Int      @default(0)
  createdAt DateTime @default(now())

  leads Lead[]
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  source     String
  phone      String?
  company    String?
  service    String?
  budget     String?
  message    String?
  campaignId String?
  createdAt  DateTime @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id])
}

model SupportTicket {
  id          String   @id @default(cuid())
  clientId    String
  subject     String
  description String
  status      String   @default("Open") // Open | In Progress | Resolved
  priority    String   @default("Medium") // Low | Medium | High
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Deliverable {
  id        String   @id @default(cuid())
  clientId  String
  projectId String?
  name      String
  url       String
  fileType  String   @default("file") // pdf | figma | zip | video | image | file
  sizeLabel String?
  createdAt DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique
  sessions  Int
  pageviews Int
  leads     Int
  createdAt DateTime @default(now())
}

model TrafficSource {
  id      String @id @default(cuid())
  name    String @unique
  percent Int
}

model TopPageStat {
  id             String @id @default(cuid())
  path           String @unique
  views          Int
  bounceRate     Int // percent
  avgTimeSeconds Int
}

model AgencyProfile {
  id        String   @id @default("singleton")
  name      String   @default("Web & Visuals")
  website   String   @default("webandvisuals.com")
  gstNumber String   @default("")
  city      String   @default("Bengaluru, India")
  updatedAt DateTime @updatedAt
}

model AdminProfile {
  id        String   @id @default("singleton")
  name      String   @default("Admin User")
  email     String   @default("admin@webandvisuals.com")
  phone     String   @default("+91 98765 43210")
  role      String   @default("Agency Owner")
  bio       String   @default("")
  updatedAt DateTime @updatedAt
}

// ---------- Authentication ----------

enum Role {
  ADMIN
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CLIENT)
  status        String    @default("Active") // Active | Disabled | Pending
  notes         String?
  clientId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client?        @relation(fields: [clientId], references: [id])
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  activityLogs  ActivityLog[]
}

// Adapter-shaped models required by @auth/prisma-adapter for OAuth account linking.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
